        <text name="ar_bs_slotNursery"   text="Dieser Stall verdient am meisten als AUFZUCHT: %s/Mon gegenüber %s/Mon mit Produzenten."/>
        <!-- NO VERDICT IS ITSELF A FINDING, so it names the term that was missing
             rather than showing a dash. -->
        <text name="ar_bs_slotNone"      text="Kein Urteil Produzent / Aufzucht für diesen Stall: %s"/>
        <text name="ar_bs_slotGapEmpty"  text="der Stall hält keine Tiere, die zu beurteilen wären."/>
