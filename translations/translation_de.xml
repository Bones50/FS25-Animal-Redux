        <text name="ar_set_autoTrader"     text="Auto-Händler"/>
        <text name="ar_set_autoTrader_tt"  text="Dauerhafte Kauf- und Verkaufsaufträge, die von selbst laufen. Aus entfernt die Schaltfläche Auto-Händler sowie Verkaufsregeln und Kaufregeln UND LÖSCHT alle eingerichteten Aufträge. Sie werden vorher um Bestätigung gebeten."/>

        <text name="ar_set_herdAdviser"       text="Herden-Berater"/>
